%% Пример: flowchart оформления заказа в корзине
flowchart TD
    A[Пользователь] --> B{Товар в наличии?}
    B -- Да --> C[Добавить в корзину]
    B -- Нет --> D[Сообщение: недоступен]
    C --> E{Оформить заказ?}
    E -- Да --> F[Оплата]
    E -- Нет --> G[Корзина сохранена]
    F --> H[Заказ отправлен на склад]
    D --> A
    G --> A