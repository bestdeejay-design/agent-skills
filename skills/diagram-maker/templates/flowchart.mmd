%% Шаблон flowchart (блок-схема)
%% Направление: TD (top-down), LR (left-right), RL, BT
%% Узлы: A[прямоугольник], B{ромб-условие}, C((круг)), D[(база данных)]
%% Связи: --> (стрелка), -- текст --> (стрелка с подписью), --- (линия)
flowchart TD
    A[Начало] --> B{Условие?}
    B -- Да --> C[Действие 1]
    B -- Нет --> D[Действие 2]
    C --> E[Конец]
    D --> E