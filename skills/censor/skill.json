{
  "name": "censor",
  "version": "1.0.0",
  "description": "Fact-checker for documentation — detects duplicates (similarity >70%) and broken internal links in markdown files. Skips code blocks, inline code, and external URLs. Configurable threshold (default 0.7) and ignore patterns. Part of Chronos Pantheon, invoked via presets minimal/standard/full.",
  "author": "best",
  "license": "MIT",
