    "broken links",
    "fact-check",
    "validation",
    "markdown",
    "docs",
    "дубликаты",
    "ссылки",
    "проверка"
  ],
  "triggers": [
    "check duplicates",
    "find duplicate docs",
    "duplicate detection",
    "broken links",
    "broken references",
    "validate links",
    "link check",
    "documentation validation",
    "doc fact-check",
    "censor",
    "найти дубликаты",
    "проверить ссылки",
    "битые ссылки",
    "валидация ссылок"
  ],
  "category": "code",
  "entrypoint": "SKILL.md",
