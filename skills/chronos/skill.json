{
  "name": "chronos",
  "version": "1.0.0",
  "description": "Documentation Timekeeper — 5 AI agents (Chronos, Censor, Dewey, Veles, Canon) for documentation integrity. Checks: duplicates, broken links, missing required docs, orphans, classification (L1-L6), stale dates. Presets: minimal (Censor only), standard (Censor+Dewey+Canon), full (all 5 agents). Supports JSON/Markdown output, CI fail-on thresholds, and .chronos.yml configuration.",
  "author": "best",
  "license": "MIT",
  "keywords": [
    "documentation",
    "audit",
    "integrity",
    "duplicates",
    "broken links",
    "classification",
    "taxonomy",
    "orphan",
    "stale",
    "docs",
    "документация",
    "аудит",
    "проверка"
  ],
  "triggers": [
    "check documentation",
    "docs audit",
    "audit docs",
    "docs integrity",
    "documentation health",
    "find duplicates in docs",
    "duplicate docs",
    "broken links",
    "broken references",
    "stale documentation",
    "outdated docs",
    "classify docs",
    "document classification",
    "orphan docs",
    "unreferenced documents",
    "validate docs",
